# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit it.

# --- Django -----------------------------------------------------------------
# Set to True ONLY on your own machine. Defaults to False (production-safe).
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG is False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
# Comma-separated. Required when DJANGO_DEBUG is False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins incl. scheme, e.g. https://shop.example.com (production)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set True when the app runs behind a reverse proxy that sets X-Forwarded-Proto
DJANGO_BEHIND_PROXY=False
# HSTS lifetime in seconds in production. Start small, raise once HTTPS is confirmed.
DJANGO_HSTS_SECONDS=3600

# --- Database ---------------------------------------------------------------
# mysql (default) or sqlite (easiest for local development)
DB_ENGINE=sqlite
DB_NAME=pharmadb
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- PayPal -----------------------------------------------------------------
# True = PayPal sandbox, False = live payments
PAYPAL_TEST=True
# The PayPal business account that receives payments
PAYPAL_RECEIVER_EMAIL=
# Prices are stored in the store currency. PayPal does not support XAF (Fcfa),
# so the amount sent to PayPal is converted using the rate below.
STORE_CURRENCY=XAF
PAYPAL_CURRENCY=USD
# How many STORE_CURRENCY units equal 1 PAYPAL_CURRENCY unit (e.g. 600 XAF per 1 USD).
# Checkout refuses to start a PayPal payment if this is unset and the currencies differ.
PAYPAL_EXCHANGE_RATE=

# --- Shop -------------------------------------------------------------------
# Maximum quantity of one product per cart line
CART_MAX_QTY=5

# --- Tailwind (Windows only) ------------------------------------------------
# NPM_BIN_PATH=C:\Program Files\nodejs\npm.cmd
